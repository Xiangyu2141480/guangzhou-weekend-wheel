{
  "name": "guangzhou-weekend-wheel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run budget",
    "budget": "node scripts/check-build-budget.mjs",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "sync:activities": "tsx scripts/sync-activities/index.ts --all",
    "sync:city": "tsx scripts/sync-activities/index.ts --city",
    "sync:check": "tsx scripts/sync-activities/index.ts --validate-only",
    "test:data": "vitest run src/data scripts/sync-activities",
    "qa:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "cheerio": "^1.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.1.11"
  }
}
